extends SceneTree
const Profile = preload("res://src/render_profile.gd")
var checks: Array[Dictionary] = []
func check(name: String, passed: bool) -> void:
	checks.append({"name":name,"passed":passed})
func _initialize() -> void:
	var value := Profile.new()
	value.configure(0,false,60)
	check("desktop auto preserves initial render scale",value.profile().scale==1.0)
	for frame in range(600): value.observe_frame(16.8,true,16.67)
	check("60FPS pacing is not classified as overload",value.automatic_stage==0)
	for frame in range(300): value.observe_frame(28.0,true,16.67)
	check("sustained work overload reduces quality",value.automatic_stage==1)
	var current: Dictionary = value.configure(0,false,60)
	check("unrelated settings reapply keeps auto choice",value.automatic_stage==1 and current.scale==0.85)
	for frame in range(600): value.observe_frame(300.0,true,300.0)
	check("single long-frame or excluded loading does not downgrade",value.automatic_stage==1)
	for frame in range(1500): value.observe_frame(28.0,false,16.67)
	check("inactive or loading frames are excluded",value.automatic_stage==1)
	for frame in range(700): value.observe_frame(28.0,true,16.67)
	check("continued overload reaches bounded lower stage",value.automatic_stage==2)
	for frame in range(2100): value.observe_frame(8.0,true,16.67)
	check("recovery is gradual and returns when sustained",value.automatic_stage==0)
	value.configure(2,false,60)
	var high: Dictionary = value.profile()
	value.configure(3,false,60)
	check("ultra has explicit anti aliasing difference",high.msaa==Viewport.MSAA_2X and value.profile().msaa==Viewport.MSAA_4X)
	for frame in range(1500): value.observe_frame(70.0,true,16.67)
	check("manual quality is not silently replaced",value.quality==3 and value.profile().msaa==Viewport.MSAA_4X)
	value.configure(0,true,30)
	check("mobile auto starts without costly shadows",value.profile().scale==0.85 and not value.profile().shadows and value.target_fps==30)
	value.configure(4,true,60)
	check("compatibility profile remains bounded",value.profile().scale==0.55 and value.profile().msaa==Viewport.MSAA_DISABLED and not value.profile().shadows)
	var report := {"checks":checks,"passed":checks.all(func(row):return row.passed),"scope":"pure render policy with synthetic timing inputs; no measured FPS or GPU performance claim"}
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://work/presentation-qa"))
	var file := FileAccess.open("res://work/presentation-qa/render-profile.json",FileAccess.WRITE)
	file.store_string(JSON.stringify(report,"  "))
	print(JSON.stringify(report))
	quit(0 if report.passed else 1)
